# Environment variable files — never commit real secrets
.env
.env.*
!.env.example

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/
.next/
out/

# Test coverage reports
coverage/

# Runtime logs
logs/
*.log
test_output.txt

# OS-generated files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
.pytest_cache/

# Editor directories
.idea/
.vscode/
*.swp
*.swo

# Kubernetes secrets (never commit real secret manifests)
k8s/*-secret.yaml
!k8s/*-secret.example.yaml
