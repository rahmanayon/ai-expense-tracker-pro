# Copy this file to .env and fill in the values for your environment.
# NEVER commit the actual .env file with real credentials.

# Database
DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<database>

# Redis
# Local (no authentication): redis://localhost:6379
# With authentication:        redis://<username>:<password>@<host>:6379
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=<strong-random-secret-min-32-chars>
JWT_REFRESH_SECRET=<strong-random-secret-min-32-chars>

# Application
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Stripe (optional — required for payment features)
STRIPE_SECRET_KEY=sk_test_<your-stripe-key>

# AWS S3 (optional — required for backup and file storage)
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
AWS_S3_BUCKET=<your-s3-bucket-name>
AWS_REGION=<your-aws-region>
