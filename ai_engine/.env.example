# Copy this file to .env and fill in the values for your environment.
# NEVER commit the actual .env file with real credentials.

# Comma-separated list of allowed origins for CORS.
# Wildcards ('*') are not permitted — always specify explicit origins.
# Example (single origin):  ALLOWED_ORIGINS=https://app.example.com
# Example (multiple):       ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=https://<your-frontend-domain>
